<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Soniya Yadav | Software Developer</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
    scroll-padding-top:72px;
}

body{
    font-family:Inter,Arial,sans-serif;
    background:#eef3f8;
    color:#14213d;
    font-size:15px;
    line-height:1.55;
}

a{
    text-decoration:none;
    color:inherit;
}

button,
input{
    font:inherit;
}

button{
    cursor:pointer;
}

img{
    display:block;
    max-width:100%;
}

:root{
    --navy:#152442;
    --navy2:#1c3153;
    --purple:#6558e8;
    --purple2:#776cf0;
    --cyan:#13aa9d;
    --orange:#ed7a24;
    --green:#0d9488;
    --text:#253a58;
    --muted:#637691;
    --line:#d9e3ee;
    --white:#fff;
    --bg:#eef3f8;
    --shadow:0 10px 28px rgba(30,53,82,.08);
}

.container{
    width:min(1140px,92%);
    margin:auto;
}

section{
    padding:58px 0;
}

/* =========================================================
   SECTION HEADINGS
========================================================= */

.section-head{
    margin-bottom:22px;
}

.section-head h2{
    font:700 29px/1.2 Poppins;
    margin-bottom:5px;
    letter-spacing:-.5px;
}

.section-head p{
    color:var(--muted);
    max-width:760px;
    font-size:14px;
}

/* =========================================================
   ANIMATION
========================================================= */

.reveal{
    opacity:0;
    transform:translateY(25px);
    transition:
        opacity .7s ease,
        transform .7s ease;
}

.reveal.show{
    opacity:1;
    transform:none;
}

.heading-animate{
    opacity:0;
    transform:translateY(16px);
    transition:.7s ease;
}

.heading-animate.show{
    opacity:1;
    transform:none;
}

/* =========================================================
   NAVBAR
========================================================= */

nav{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,255,255,.94);
    backdrop-filter:blur(14px);
    border-bottom:1px solid #e0e7ef;
}

.nav-inner{
    height:66px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-weight:800;
    font-size:19px;
}

.logo span{
    color:var(--purple);
}

.nav-links{
    display:flex;
    align-items:center;
    gap:20px;
}

.nav-links a{
    font-size:13px;
    font-weight:700;
    color:#5b6f89;
    transition:.2s;
}

.nav-links a:hover{
    color:var(--purple);
}

.nav-links .hire{
    background:var(--navy);
    color:#fff;
    padding:9px 14px;
    border-radius:8px;
}

.menu{
    display:none;
    border:0;
    background:none;
    color:var(--navy);
    font-size:22px;
}

/* =========================================================
   HERO
========================================================= */

.hero{
    padding:60px 0 45px;
    background:
    radial-gradient(
        circle at 5% 20%,
        rgba(101,88,232,.10),
        transparent 28%
    ),
    radial-gradient(
        circle at 95% 80%,
        rgba(19,170,157,.10),
        transparent 28%
    );
}

.hero-grid{
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:45px;
    align-items:center;
}

.available{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:#fff;
    border:1px solid var(--line);
    padding:7px 11px;
    border-radius:20px;
    font-size:11px;
    color:#5b708a;
    margin-bottom:15px;
}

.dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:#10b981;
    box-shadow:0 0 0 4px #dcfce7;
}

.hero h1{
    font:700 clamp(38px,5vw,56px)/1.03 Poppins;
    letter-spacing:-2.5px;
    margin-bottom:15px;
}

.hero h1 span{
    color:var(--purple);
}

.hero-sub{
    font-size:15px;
    color:#5c718c;
    max-width:620px;
    margin-bottom:17px;
}

.work-line{
    display:flex;
    align-items:center;
    gap:9px;
    color:var(--purple);
    font-size:13px;
    font-weight:700;
    margin-bottom:17px;
}

.work-line i{
    font-size:14px;
}

.buttons{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:14px;
}

.btn{
    display:inline-flex;
    align-items:center;
    gap:7px;
    border:1px solid var(--line);
    background:#fff;
    border-radius:8px;
    padding:9px 12px;
    font-size:12px;
    font-weight:800;
    transition:.25s;
}

.btn:hover{
    transform:translateY(-2px);
    box-shadow:var(--shadow);
}

.btn.primary{
    background:var(--navy);
    color:#fff;
    border-color:var(--navy);
}

.socials{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
    color:#637792;
    font-size:12px;
    font-weight:600;
}

.socials a:hover{
    color:var(--purple);
}

/* =========================================================
   HERO CARD
========================================================= */

.hero-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:20px;
    padding:22px;
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
}

.hero-card:before{
    content:"";
    position:absolute;
    right:-50px;
    top:-62px;
    width:165px;
    height:165px;
    border-radius:50%;
    background:#eeeaff;
}

.hero-card>*{
    position:relative;
}

.profile-top{
    display:flex;
    align-items:center;
    gap:15px;
    margin-bottom:17px;
}

.profile-img{
    width:82px;
    height:82px;
    object-fit:cover;
    border-radius:17px;
    border:3px solid #fff;
    box-shadow:0 4px 14px rgba(0,0,0,.14);
}

.small-label{
    font-size:10px;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:#73849c;
}

.profile-top h3{
    font-size:20px;
    margin:3px 0;
}

.profile-top p{
    font-size:13px;
    color:#637793;
}

.welcome{
    border:1px solid #e1e7f0;
    background:#f8faff;
    border-radius:12px;
    padding:14px 15px;
    margin-bottom:13px;
}

.welcome strong{
    display:block;
    font-size:14px;
    margin-bottom:4px;
    color:var(--purple);
}

.welcome p{
    font-size:12px;
    color:#637691;
    line-height:1.55;
}

.hero-bottom{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
}

.hero-stat{
    background:#f4f7fb;
    border-radius:10px;
    text-align:center;
    padding:10px 5px;
}

.hero-stat strong{
    display:block;
    font-size:13px;
}

.hero-stat span{
    font-size:10px;
    color:#71839c;
}

/* =========================================================
   SKILLS
========================================================= */

.skills-section{
    background:var(--navy);
    color:#fff;
}

.skills-section .section-head p{
    color:#b7c6da;
}

.skills-box{
    background:#1b2d4b;
    border:1px solid rgba(255,255,255,.08);
    border-radius:16px;
    padding:20px;
}

.skill-category{
    padding:16px 0;
}

.skill-category:first-child{
    padding-top:0;
}

.skill-category:last-child{
    padding-bottom:0;
}

.skill-category + .skill-category{
    border-top:1px solid rgba(255,255,255,.08);
}

.skill-category h3{
    font-size:14px;
    margin-bottom:10px;
    color:#f1f5fa;
}

.skills{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.skill{
    display:inline-flex;
    align-items:center;
    gap:7px;
    background:#243b5d;
    border:1px solid rgba(255,255,255,.08);
    border-radius:8px;
    padding:8px 10px;
    font-size:12px;
    font-weight:700;
    transition:.2s;
}

.skill:hover{
    transform:translateY(-2px);
    background:#2b456d;
}

.skill i{
    font-size:15px;
}

.java i{color:#f18b28}
.python i{color:#55a9eb}
.js i{color:#f7d51c}
.html i{color:#ff7043}
.css i{color:#42a5e8}
.php i{color:#a8a9d6}
.react i{color:#61dafb}
.node i{color:#72bf75}
.express i{color:#fff}
.mern i{color:#6dd5ed}
.spring i{color:#70c174}
.sql i{color:#75add1}
.mongo i{color:#67c26b}
.github i{color:#fff}
.git i{color:#ff7254}
.eclipse i{color:#a6d7ff}
.copilot i{color:#9d8cff}
.tailwind i{color:#55d5f4}

/* =========================================================
   ABOUT
========================================================= */

.about-section{
    background:#f7f3ff;
}

.about-intro{
    background:linear-gradient(
        135deg,
        #6659e9,
        #7b70f0
    );
    color:#fff;
    border-radius:17px;
    padding:21px 23px;
    margin-bottom:13px;
    box-shadow:0 12px 25px rgba(101,88,232,.16);
}

.about-intro h3{
    font:700 22px Poppins;
    margin-bottom:4px;
}

.about-intro p{
    font-size:13px;
    color:#f1efff;
    max-width:850px;
}

.about-cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.about-card{
    background:#fff;
    border:1px solid #e0daf4;
    border-radius:13px;
    padding:15px;
}

.about-card i{
    color:var(--purple);
    font-size:18px;
    margin-bottom:7px;
}

.about-card h3{
    font-size:13px;
    margin-bottom:3px;
}

.about-card p{
    font-size:11px;
    color:#657893;
    line-height:1.5;
}

/* =========================================================
   PROJECTS
========================================================= */

.projects-section{
    background:#eaf1f8;
}

.projects-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:14px;
    align-items:stretch;
}

.project-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 7px 20px rgba(30,50,80,.06);
    display:flex;
    flex-direction:column;
    transition:.3s;
    min-width:0;
}

.project-card:hover{
    transform:translateY(-4px);
    box-shadow:0 15px 30px rgba(30,50,80,.11);
}

.project-carousel{
    height:190px;
    background:#dfe8f1;
    position:relative;
    overflow:hidden;
    touch-action:pan-y;
}

.project-slide{
    display:none;
    width:100%;
    height:100%;
    object-fit:cover;
}

.project-slide.active{
    display:block;
    animation:slideIn .45s ease;
}

@keyframes slideIn{
    from{
        opacity:.3;
        transform:scale(1.025);
    }
    to{
        opacity:1;
        transform:none;
    }
}

.carousel-btn{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:30px;
    height:30px;
    border:0;
    border-radius:50%;
    background:rgba(15,28,49,.78);
    color:#fff;
    display:grid;
    place-items:center;
    z-index:2;
}

.carousel-btn.prev{
    left:9px;
}

.carousel-btn.next{
    right:9px;
}

.carousel-dots{
    position:absolute;
    bottom:9px;
    left:0;
    right:0;
    display:flex;
    justify-content:center;
    gap:5px;
}

.carousel-dots button{
    width:6px;
    height:6px;
    border:0;
    border-radius:50%;
    background:rgba(255,255,255,.7);
    padding:0;
}

.carousel-dots button.active{
    width:18px;
    border-radius:5px;
    background:#fff;
}

.carousel-label{
    position:absolute;
    top:9px;
    left:9px;
    background:rgba(15,28,49,.72);
    color:#fff;
    border-radius:5px;
    padding:4px 7px;
    font-size:9px;
    z-index:2;
}

.project-content{
    padding:15px;
    display:flex;
    flex-direction:column;
    flex:1;
}

.project-content h3{
    font-size:17px;
    line-height:1.25;
    margin-bottom:6px;
}

.project-content>p{
    font-size:12px;
    color:#637691;
    line-height:1.5;
    margin-bottom:10px;
}

.tags{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
    margin-bottom:12px;
}

.tag{
    font-size:9px;
    font-weight:700;
    background:#f5f7fa;
    border:1px solid #dce4ed;
    padding:4px 6px;
    border-radius:5px;
}

.project-actions{
    margin-top:auto;
    display:flex;
    gap:6px;
}

.project-actions button,
.project-actions a{
    border:1px solid var(--line);
    background:#fff;
    border-radius:7px;
    padding:8px 9px;
    font-size:10px;
    font-weight:800;
}

.project-actions .main{
    background:var(--navy);
    color:#fff;
    border-color:var(--navy);
}

/* =========================================================
   PROJECT MODAL
========================================================= */

.modal{
    position:fixed;
    inset:0;
    z-index:3000;
    background:rgba(10,21,39,.76);
    backdrop-filter:blur(7px);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.show{
    display:flex;
}

.modal-box{
    width:min(780px,95%);
    max-height:88vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    padding:20px;
}

.modal-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:13px;
}

.modal-head h2{
    font-size:20px;
}

.close{
    width:34px;
    height:34px;
    border-radius:50%;
    border:1px solid var(--line);
    background:#fff;
}

.project-info{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:9px;
}

.info-box{
    border:1px solid var(--line);
    background:#f9fbfd;
    border-radius:10px;
    padding:12px;
}

.info-box strong{
    display:block;
    font-size:11px;
    margin-bottom:3px;
    color:var(--purple);
}

.info-box p{
    font-size:12px;
    color:#627691;
    line-height:1.55;
}

/* =========================================================
   EDUCATION
========================================================= */

.education-section{
    background:#fff;
}

.timeline{
    position:relative;
    max-width:900px;
    margin:auto;
    padding:5px 0;
}

.timeline:before{
    content:"";
    position:absolute;
    left:142px;
    top:10px;
    bottom:10px;
    width:3px;
    background:linear-gradient(
        var(--purple),
        var(--cyan)
    );
}

.timeline-item{
    display:grid;
    grid-template-columns:120px 1fr;
    gap:47px;
    position:relative;
    margin-bottom:14px;
}

.timeline-year{
    text-align:right;
    color:var(--purple);
    font-size:11px;
    font-weight:800;
    padding-top:13px;
    white-space:nowrap;
}

.timeline-dot{
    position:absolute;
    left:131px;
    top:12px;
    width:21px;
    height:21px;
    border-radius:50%;
    background:#fff;
    border:5px solid var(--purple);
    box-shadow:0 0 0 4px #eeeaff;
}

.timeline-card{
    background:#f8fafc;
    border:1px solid var(--line);
    border-radius:11px;
    padding:12px 15px;
}

.timeline-card h3{
    font-size:14px;
}

.timeline-card p{
    font-size:11px;
    color:#647691;
    margin-top:3px;
    line-height:1.45;
}

.edu-result{
    display:inline-block;
    margin-top:7px;
    padding:4px 8px;
    border-radius:6px;
    background:#eeeaff;
    color:var(--purple);
    font-size:10px;
    font-weight:800;
}

/* =========================================================
   TRAINING
========================================================= */

.training-section{
    background:#fff5e9;
}

.training-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:13px;
}

.training-card{
    background:#fff;
    border:1px solid #f0ddc5;
    border-radius:14px;
    padding:17px;
    transition:.25s;
}

.training-card:hover{
    transform:translateY(-3px);
    box-shadow:var(--shadow);
}

.training-icon{
    width:38px;
    height:38px;
    border-radius:10px;
    display:grid;
    place-items:center;
    background:#fff0df;
    color:var(--orange);
    margin-bottom:9px;
}

.training-card h3{
    font-size:16px;
    margin-bottom:4px;
}

.training-card p{
    font-size:11px;
    color:#667a94;
    line-height:1.55;
    margin-bottom:9px;
}

.training-tags{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
}

.training-tags span{
    font-size:9px;
    font-weight:700;
    padding:5px 7px;
    border-radius:5px;
    background:#fff8ef;
    border:1px solid #f0d7ba;
    color:#985c25;
}

/* =========================================================
   ACHIEVEMENTS + CERTIFICATES
========================================================= */

.highlights-section{
    background:#f4f6ff;
}

.highlight-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}

.highlight-card{
    background:#fff;
    border:1px solid #dce4f1;
    border-radius:14px;
    padding:13px;
    transition:.25s;
}

.highlight-card:hover{
    transform:translateY(-3px);
    box-shadow:var(--shadow);
}

.highlight-image{
    height:230px;
    border-radius:9px;
    overflow:hidden;
    background:#eef2f7;
    margin-bottom:10px;
}

.highlight-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.highlight-card i{
    color:var(--purple);
    font-size:18px;
    margin-bottom:6px;
}

.highlight-card h3{
    font-size:13px;
    margin-bottom:4px;
}

.highlight-card p{
    font-size:11px;
    color:#687993;
    line-height:1.5;
}

/* =========================================================
   EXPLORING
========================================================= */

.exploring-section{
    background:#e9fbf7;
}

.exploring-box{
    background:#fff;
    border:1px solid #cfe9e3;
    border-radius:14px;
    padding:17px;
}

.exploring-top{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:12px;
}

.exploring-icon{
    width:38px;
    height:38px;
    border-radius:10px;
    background:#dcf8f2;
    color:#0d9488;
    display:grid;
    place-items:center;
}

.exploring-top h3{
    font-size:15px;
}

.exploring-top p{
    font-size:10px;
    color:#647691;
}

.exploring-skills{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
}

.explore-tag{
    display:inline-flex;
    align-items:center;
    gap:6px;
    background:#f4fffc;
    border:1px solid #cfe9e3;
    color:#35665f;
    border-radius:7px;
    padding:7px 9px;
    font-size:10px;
    font-weight:800;
}

/* =========================================================
   CONTACT
========================================================= */

.contact-section{
    background:#eef0ff;
    padding:35px 0 25px;
}

.contact-mini{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    background:#17243f;
    color:#fff;
    border-radius:15px;
    padding:18px 20px;
}

.contact-mini h2{
    font:700 20px Poppins;
}

.contact-mini p{
    font-size:11px;
    color:#c2ccdd;
    margin-top:2px;
}

.contact-links{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
}

.contact-link{
    display:inline-flex;
    align-items:center;
    gap:6px;
    background:#243556;
    border:1px solid rgba(255,255,255,.1);
    border-radius:7px;
    padding:8px 10px;
    font-size:10px;
    font-weight:700;
}

.contact-link:hover{
    background:#30456d;
}

/* =========================================================
   FOOTER
========================================================= */

footer{
    background:#101a2e;
    color:#d9e2ee;
    font-size:10px;
    padding:13px 0;
}

.footer-inner{
    display:flex;
    justify-content:space-between;
    gap:10px;
}

/* =========================================================
   ASK ME FLOATING BUTTON
========================================================= */

.ask-ai{
    position:fixed;
    right:20px;
    bottom:20px;
    z-index:1500;
    width:46px;
    height:46px;
    border-radius:50%;
