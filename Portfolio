const slideIndex=
projects.map(()=>0);


function setSlide(project,index){

const wrap=
document.querySelector(
`[data-project="${project}"]`
);

const slides=
wrap.querySelectorAll(".project-slide");

const dots=
wrap.querySelectorAll(
".carousel-dots button"
);

slideIndex[project]=
(index+slides.length)%slides.length;

slides.forEach((slide,i)=>{

slide.classList.toggle(
"active",
i===slideIndex[project]
);

});

dots.forEach((dot,i)=>{

dot.classList.toggle(
"active",
i===slideIndex[project]
);

});

}


function moveSlide(project,step){

setSlide(
project,
slideIndex[project]+step
);

}


function goSlide(project,index){

setSlide(project,index);

}


/* AUTO SLIDE */

setInterval(()=>{

projects.forEach((_,i)=>{

moveSlide(i,1);

});

},4500);


/* =========================================================
   TOUCH / SWIPE
========================================================= */

document.querySelectorAll(".project-carousel")
.forEach((carousel,index)=>{

let startX=0;

carousel.addEventListener(
"touchstart",
e=>{
startX=e.touches[0].clientX;
},
{passive:true}
);

carousel.addEventListener(
"touchend",
e=>{

const endX=
e.changedTouches[0].clientX;

const distance=endX-startX;

if(Math.abs(distance)>45){

moveSlide(
index,
distance<0 ? 1 : -1
);

}

},
{passive:true}
);

});


