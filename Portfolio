<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Soniya Yadav — Software Developer portfolio">
<title>Soniya Yadav | Software Developer</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

<style>
 :root{
  --bg:#f7f8fc; --bg2:#eef2f8; --card:#ffffff; --text:#172033; --muted:#667085;
  --line:#e1e6ef; --accent:#5b50d8; --accent2:#079f82; --blue:#2878d4; --pink:#d9578f; --gold:#c88700;
  --navy:#172554; --shadow:0 12px 35px rgba(28,39,67,.08); --radius:18px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:"DM Sans",sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}
a{text-decoration:none;color:inherit}
button{font:inherit}
.container{width:min(1120px,calc(100% - 40px));margin:auto}
section{padding:78px 0;scroll-margin-top:88px;position:relative}
section:nth-of-type(even){background:#f0f4f9;border-top:1px solid #e6ebf2;border-bottom:1px solid #e6ebf2}
::selection{background:#dcd8ff;color:#172033}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:-2;background:radial-gradient(circle at 8% 0%,rgba(91,80,216,.07),transparent 24%),radial-gradient(circle at 94% 30%,rgba(7,159,130,.05),transparent 22%)}
body:after{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;background:linear-gradient(180deg,rgba(255,255,255,.55),transparent 35%)}
/* navigation */
.nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(255,255,255,.92);backdrop-filter:blur(14px);border-bottom:1px solid transparent;transition:.25s}
.nav.scrolled{border-color:var(--line);box-shadow:0 6px 25px rgba(23,37,84,.06)}
.nav-inner{height:78px;display:flex;align-items:center;justify-content:space-between}
.logo{font:700 24px "Space Grotesk";letter-spacing:-.7px;color:var(--navy)} .logo span{color:var(--accent)}
.nav-links{display:flex;align-items:center;gap:3px;padding:5px;border:1px solid var(--line);border-radius:14px;background:#fff}
.nav-links a{font-size:14px;font-weight:600;color:#536078;padding:10px 14px;border-radius:10px;min-height:42px;display:flex;align-items:center;transition:.2s}
.nav-links a:hover,.nav-links a.active{color:var(--accent);background:#f0efff}
.nav-links .nav-cta{background:var(--navy);color:#fff;margin-left:4px;padding:10px 16px}.nav-links .nav-cta:hover{background:var(--accent);color:#fff}
.menu{display:none;background:none;border:0;color:var(--navy);font-size:23px}
/* hero */
.hero{min-height:92vh;display:flex;align-items:center;padding-top:120px}
.hero-grid{display:grid;grid-template-columns:1.28fr .72fr;gap:50px;align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:9px;padding:7px 11px;border:1px solid var(--line);background:#fff;border-radius:999px;color:#536078;font-size:12px;margin-bottom:20px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--accent2)}
h1{font:700 clamp(48px,6.6vw,82px)/.98 "Space Grotesk";letter-spacing:-4px;margin-bottom:22px;color:var(--navy)}
.gradient{color:var(--accent)}
.hero p{max-width:670px;color:var(--muted);font-size:17px;line-height:1.75}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 17px;border-radius:11px;border:1px solid var(--line);transition:.2s;font-weight:600;font-size:13px;background:#fff}
.btn.primary{background:var(--navy);color:#fff;border-color:var(--navy)}.btn.primary:hover{background:var(--accent);border-color:var(--accent);transform:translateY(-2px)}.btn.secondary:hover{border-color:#bdb7f6;background:#f5f3ff;transform:translateY(-2px)}
.hero-card{border:1px solid #dfe4ed;border-radius:24px;background:#fff;box-shadow:var(--shadow);padding:26px;overflow:hidden}
.profile-mark{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:#f0efff;color:var(--accent);font:700 28px "Space Grotesk";margin-bottom:16px;border:1px solid #dedaff;overflow:hidden}
.profile-mark img{display:block;width:100%;height:100%;object-fit:cover;border-radius:inherit}
.card-label{font-size:11px;color:#7a8496;text-transform:uppercase;letter-spacing:1.5px}.hero-card h3{font:600 23px "Space Grotesk";margin:7px 0 7px;color:var(--navy)}.hero-card p{font-size:13px;color:var(--muted);line-height:1.65}
.mini-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:20px}
.mini-stat{min-height:64px;padding:8px 3px;border:1px solid var(--line);border-radius:11px;background:#fbfcfe;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;transition:.2s}
.mini-stat i{font-size:21px;line-height:1}.mini-stat span{font-size:9px;font-weight:600;color:#39445a;text-align:center;white-space:nowrap}.mini-stat:hover{transform:translateY(-3px);border-color:#cfcaf9;background:#f7f6ff}.mini-stat .github-logo{color:#536078!important;-webkit-text-fill-color:#536078!important}
/* headings */
.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}.kicker{display:inline-flex;color:var(--accent);font-size:11px;text-transform:uppercase;letter-spacing:1.8px;font-weight:700;margin-bottom:8px;padding:5px 9px;border-radius:999px;background:#f0efff;border:1px solid #dedaff}.section-head h2{font:700 clamp(29px,4vw,43px) "Space Grotesk";letter-spacing:-1.7px;color:var(--navy)}.section-head h2:after{content:"";display:block;width:42px;height:3px;border-radius:4px;margin-top:11px;background:var(--accent)}.section-head p{max-width:450px;color:var(--muted);font-size:13px}
/* about + skills */
.about-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:18px}.about-box,.skills-main,.timeline-item,.contact-box,.achievement{border:1px solid var(--line);background:#fff;border-radius:18px;padding:25px;box-shadow:0 8px 25px rgba(23,37,84,.045)}.about-box h3{font:600 21px "Space Grotesk";margin-bottom:11px;color:var(--navy)}.about-box p{color:var(--muted);font-size:14px}.quick-list{display:grid;gap:11px;margin-top:19px}.quick-list div{display:flex;align-items:center;gap:10px;color:#536078;font-size:13px}.quick-list i{width:18px;color:var(--accent)}
.skills-main{border-color:#d9d6fb;background:linear-gradient(135deg,#fff,#faf9ff)}.skills-title{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:18px}.skills-title h3{font:700 25px "Space Grotesk";color:var(--navy)}.skills-title span{font-size:10px;color:#69758a;border:1px solid var(--line);padding:6px 9px;border-radius:999px}.skill-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.skill-card{padding:18px;border:1px solid var(--line);border-radius:14px;background:#fff;transition:.2s}.skill-card:hover{transform:translateY(-2px);border-color:#d0ccf7}.skill-card i{font-size:20px;color:var(--accent)}.skill-card h4{margin:8px 0 5px;font-size:14px}.skill-card p{font-size:12px;color:var(--muted);line-height:1.6}.skill-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}.skill-chip{font-size:10px;padding:6px 9px;border-radius:8px;background:#f5f7fa;border:1px solid #e3e7ee;color:#59657a}
/* projects */
.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.project{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:18px;background:#fff;padding:23px;min-height:285px;box-shadow:0 8px 25px rgba(23,37,84,.045);transition:.2s}.project:before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:var(--accent)}.project:nth-child(2):before{background:var(--accent2)}.project:nth-child(3):before{background:var(--blue)}.project:hover{transform:translateY(-4px);box-shadow:0 14px 35px rgba(23,37,84,.09)}.project-number{font:700 10px "Space Grotesk";color:#7a8496;letter-spacing:1px}.project h3{font:600 22px "Space Grotesk";margin:38px 0 8px;color:var(--navy)}.project p{color:var(--muted);font-size:13px;max-width:500px}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:18px}.tag{padding:5px 8px;border-radius:7px;background:#f3f5f8;color:#59657a;font-size:10px;border:1px solid #e3e7ee}.project-links{display:flex;gap:10px;margin-top:20px}.project-link{font-size:12px;font-weight:600;color:#4f5b72}.project-link i{color:var(--accent);margin-right:5px}
/* timeline */
.timeline{display:grid;gap:9px}.timeline-item{display:grid;grid-template-columns:145px 1fr;gap:20px}.timeline-date{color:var(--accent);font-size:12px;font-weight:700}.timeline-item h3{font:600 18px "Space Grotesk";color:var(--navy)}.timeline-item h4{font-size:12px;color:#69758a;margin:3px 0 8px}.timeline-item p{color:var(--muted);font-size:13px}
/* achievements */
.achievement-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.achievement{padding:21px}.achievement i{font-size:19px;color:var(--accent)}.achievement h3{font-size:14px;margin:10px 0 5px;color:var(--navy)}.achievement p{color:var(--muted);font-size:11px}
/* certificates */
.cert-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.cert-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 8px 25px rgba(23,37,84,.045)}.cert-icon{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:#f0efff;color:var(--accent);margin-bottom:13px}.cert-card h3{font:600 15px "Space Grotesk";color:var(--navy)}.cert-card p{font-size:11px;color:var(--muted);margin:5px 0 14px}.view-cert{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--accent);padding:7px 10px;border:1px solid #d8d4fb;border-radius:8px;background:#f8f7ff}.view-cert:hover{background:#f0efff}
.cert-modal{position:fixed;inset:0;background:rgba(17,32,55,.72);display:none;align-items:center;justify-content:center;padding:25px;z-index:2000}.cert-modal.open{display:flex}.cert-modal-box{position:relative;max-width:900px;max-height:90vh;background:#fff;border-radius:16px;padding:12px}.cert-modal img{display:block;max-width:100%;max-height:82vh;object-fit:contain;border-radius:8px}.cert-close{position:absolute;right:-10px;top:-10px;width:34px;height:34px;border:0;border-radius:50%;background:#172033;color:#fff;cursor:pointer}
/* contact/footer */
.contact-box{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:34px;background:linear-gradient(135deg,#f4f2ff,#effbf8);border-color:#dcdaf4}.contact-box h2{font:700 clamp(29px,4vw,45px) "Space Grotesk";letter-spacing:-1.7px;color:var(--navy)}.contact-box p{color:var(--muted);margin-top:7px;font-size:13px}.contact-actions{display:flex;gap:8px;flex-wrap:wrap}footer{border-top:1px solid var(--line);padding:25px 0;color:#788297;font-size:11px;background:#fff}.footer-inner{display:flex;justify-content:space-between;gap:20px}
.reveal{opacity:0;transform:translateY(18px);transition:.55s ease}.reveal.show{opacity:1;transform:none}
/* headings */
.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:42px}
.kicker{display:inline-flex;color:var(--accent2);font-size:12px;text-transform:uppercase;letter-spacing:2px;font-weight:700;margin-bottom:9px;padding:6px 10px;border-radius:999px;background:rgba(57,230,192,.08);border:1px solid rgba(57,230,192,.18)}
.section-head h2{font:700 clamp(30px,4vw,46px) "Space Grotesk";letter-spacing:-2px}
.section-head h2:after{content:"";display:block;width:54px;height:4px;border-radius:5px;margin-top:14px;background:linear-gradient(90deg,var(--accent),var(--accent2))}
.section-head p{max-width:470px;color:var(--muted);font-size:14px}

/* about */
.about-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:25px}
.about-box,.skill-card,.timeline-item,.contact-box{
  border:1px solid var(--line);background:#ffffff;
  border-radius:var(--radius);padding:28px;
}
.about-box h3{font:600 22px "Space Grotesk";margin-bottom:13px}
.about-box p{color:var(--muted);font-size:15px}
.quick-list{display:grid;gap:13px;margin-top:22px}
.quick-list div{display:flex;align-items:center;gap:12px;color:#cbd0da;font-size:14px}
.quick-list i{width:20px;color:var(--accent)}
.skills-main{
  border:1px solid rgba(139,124,255,.28);
  border-radius:28px;
  padding:30px;
  background:
    linear-gradient(135deg,rgba(139,124,255,.10),rgba(77,163,255,.05) 45%,rgba(57,230,192,.06)),
    rgba(255,255,255,.025);
  box-shadow:0 25px 70px rgba(75,65,180,.10);
  position:relative;
  overflow:hidden;
}
.skills-main:before{
  content:"";position:absolute;right:-90px;top:-100px;width:260px;height:260px;
  border-radius:50%;background:rgba(139,124,255,.16);filter:blur(55px);
}
.skills-title{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:22px}
.skills-title h3{font:700 27px "Space Grotesk";letter-spacing:-1px}
.skills-title span{font-size:11px;color:#b8c0d2;border:1px solid var(--line);padding:7px 10px;border-radius:999px}
.skill-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;position:relative}
.skill-card{padding:22px;border:1px solid var(--line);border-radius:18px;background:rgba(7,9,20,.42);transition:.25s}
.skill-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.22);background:rgba(255,255,255,.05)}
.skill-card i{font-size:22px}
.skill-card:nth-child(1) i{color:var(--gold)}
.skill-card:nth-child(2) i{color:var(--blue)}
.skill-card:nth-child(3) i{color:var(--accent2)}
.skill-card:nth-child(4) i{color:var(--pink)}
.skill-card h4{margin:10px 0 7px;font-size:15px}
.skill-card p{font-size:13px;color:var(--muted);line-height:1.65}
.skill-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px;position:relative}
.skill-chip{font-size:11px;padding:8px 11px;border-radius:10px;background:rgba(255,255,255,.055);border:1px solid var(--line);color:#dbe0eb}


/* prominent skills */
.skill-showcase{
  margin-top:25px;padding:36px;border-radius:30px;
  border:1px solid rgba(139,124,255,.25);
  background:
    radial-gradient(circle at 100% 0%,rgba(102,87,232,.12),transparent 35%),
    radial-gradient(circle at 0% 100%,rgba(16,168,139,.08),transparent 30%),
    linear-gradient(135deg,#ffffff,#f7f9fd);
  box-shadow:0 20px 55px rgba(42,55,82,.10);
}
.skill-top{display:flex;align-items:flex-start;justify-content:space-between;gap:25px}
.skill-top h2{font:700 clamp(34px,5vw,54px) "Space Grotesk";letter-spacing:-2.2px;color:var(--navy)}
.skill-intro{color:var(--muted);max-width:560px;margin-top:9px;font-size:14px}
.skill-kicker{color:#b8adff;background:#f1efff;border-color:#ddd8ff}
.skill-badge{
  display:flex;align-items:center;gap:8px;padding:11px 14px;border-radius:14px;
  background:#effbf8;border:1px solid #c9eee6;
  color:#78f4d6;font-size:12px;font-weight:700;white-space:nowrap;
}
.skill-cloud{display:flex;flex-wrap:wrap;gap:7px;margin:30px 0 27px}
.skill-pill{
  display:inline-flex;align-items:center;gap:9px;padding:12px 15px;border-radius:13px;
  background:#f8fafc;border:1px solid #e2e7ef;
  color:#eef2fa;font-weight:600;font-size:14px;transition:.25s;
}
.skill-pill:hover{transform:translateY(-4px);background:rgba(255,255,255,.08);box-shadow:0 10px 30px rgba(0,0,0,.2)}
.skill-pill i{font-size:17px}
.skill-pill.java i{color:#ff6b7a}.skill-pill.python i{color:#ffd166}
.skill-pill.js i{color:#f7df1e}.skill-pill.html i{color:#ff7043}
.skill-pill.css i{color:#48a8ff}.skill-pill.php i{color:#9b8cff}
.skill-pill.sql i{color:#55b7ff}.skill-pill.react i{color:#61dafb}
.skill-pill.tailwind i{color:#38bdf8}.skill-pill.mysql i{color:#66c7ff}
.skill-pill.mongo i{color:#55d68a}.skill-pill.git i{color:#ff8a65}
.skill-pill.vscode i{color:#42a5f5}.skill-pill.eclipse i{color:#c8cbd4}
.skill-pill.xampp i{color:#ff9f43}
.skill-groups{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.skill-groups div{padding:16px;border-radius:15px;background:#f8fafc;border:1px solid #e4e9f1}
.skill-groups strong{display:block;font-size:12px;color:#fff;margin-bottom:5px}
.skill-groups span{font-size:11px;color:var(--muted);line-height:1.55}

/* projects */
.projects{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.project{
  position:relative;overflow:hidden;border:1px solid var(--line);
  border-radius:20px;background:var(--card);padding:24px;min-height:300px;box-shadow:0 9px 30px rgba(23,37,84,.055);
  transition:.3s;
}
.project:before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg,var(--accent),var(--blue));opacity:.85}
.project:nth-child(2):before{background:linear-gradient(90deg,var(--accent2),var(--blue))}
.project:nth-child(3):before{background:linear-gradient(90deg,var(--pink),var(--accent))}
.project:nth-child(4):before{background:linear-gradient(90deg,var(--gold),var(--pink))}
.project:nth-child(1){background:linear-gradient(145deg,#f5f2ff,#fff 48%)}
.project:nth-child(2){background:linear-gradient(145deg,#effbf8,#fff 48%)}
.project:nth-child(3){background:linear-gradient(145deg,#eef7ff,#fff 48%)}
.project:nth-child(4){background:linear-gradient(145deg,#fff2f7,#fff 48%)}
.project:hover{transform:translateY(-6px);border-color:rgba(139,124,255,.5);box-shadow:var(--shadow)}
.project-number{font:700 12px "Space Grotesk";color:#707887}
.project h3{font:600 25px "Space Grotesk";margin:45px 0 9px}
.project p{color:var(--muted);font-size:14px;max-width:500px}
.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:22px}
.tag{padding:6px 9px;border-radius:8px;background:#f0f3f8;color:#536079;font-size:11px;border:1px solid var(--line)}
.project-links{display:flex;gap:10px;margin-top:25px}
.project-link{font-size:12px;color:#4f5b72}
.project-link i{color:var(--accent);margin-right:5px}

/* experience / education */
.timeline{display:grid;gap:12px}
.timeline-item{display:grid;grid-template-columns:150px 1fr;gap:25px}
.timeline-date{color:var(--accent);font-size:13px;font-weight:700}
.timeline-item h3{font:600 20px "Space Grotesk"}
.timeline-item h4{font-size:13px;color:#69758a;margin:4px 0 12px}
.timeline-item p{color:var(--muted);font-size:14px}
.bullets{margin-top:10px;padding-left:18px;color:var(--muted);font-size:13px}

/* achievement */
.achievement-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.achievement{padding:23px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.025)}
.achievement i{font-size:20px;color:var(--accent2)}
.achievement h3{font-size:15px;margin:13px 0 5px}
.achievement p{color:var(--muted);font-size:12px}

/* contact */
.contact-box{display:flex;align-items:center;justify-content:space-between;gap:35px;padding:40px;border-color:#ccece5;background:linear-gradient(135deg,#effbf8,#f3f1ff)}
.contact-box h2{font:700 clamp(30px,4vw,48px) "Space Grotesk";letter-spacing:-2px}
.contact-box p{color:var(--muted);margin-top:9px}
.contact-actions{display:flex;gap:10px;flex-wrap:wrap}
footer{border-top:1px solid var(--line);padding:28px 0;color:#788297;font-size:12px;background:#fff}
.footer-inner{display:flex;justify-content:space-between;gap:20px}

/* reveal */
.reveal{opacity:0;transform:translateY(22px);transition:.7s ease}
.reveal.show{opacity:1;transform:none}

/* mobile */
@media(max-width:850px){
  .container{width:min(100% - 28px,680px)}
  section{padding:68px 0}
  .nav-inner{height:72px}
  .nav-links{position:absolute;top:80px;left:14px;right:14px;display:none;flex-direction:column;align-items:stretch;padding:9px;background:#fff;border:1px solid var(--line);border-radius:15px;box-shadow:0 16px 35px rgba(23,37,84,.12)}
