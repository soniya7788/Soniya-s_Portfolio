========================================================= */

const observer=
new IntersectionObserver(
entries=>{

entries.forEach(entry=>{

if(entry.isIntersecting){

entry.target.classList.add("show");

observer.unobserve(entry.target);

}

});

},
{
threshold:.12
}
);


document
.querySelectorAll(".reveal,.heading-animate")
.forEach(element=>{

observer.observe(element);

});

