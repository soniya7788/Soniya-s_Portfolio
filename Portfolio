.ai-panel{
    position:fixed;
    right:20px;
    bottom:78px;
    width:340px;
    max-width:calc(100vw - 30px);
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    box-shadow:0 20px 45px rgba(20,35,60,.18);
    z-index:1499;
    overflow:hidden;
    display:none;
}

.ai-panel.show{
    display:block;
    animation:aiOpen .25s ease;
}

@keyframes aiOpen{
    from{
        opacity:0;
        transform:translateY(10px) scale(.97);
    }
    to{
        opacity:1;
        transform:none;
    }
}

.ai-head{
    background:var(--navy);
    color:#fff;
    padding:14px 15px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.ai-title{
    display:flex;
    align-items:center;
    gap:9px;
}

.ai-title-icon{
    width:32px;
    height:32px;
    border-radius:9px;
    background:#2b3d60;
    display:grid;
    place-items:center;
}

.ai-title h3{
    font-size:13px;
}

.ai-title p{
    font-size:9px;
    color:#b9c7dc;
}

.ai-close{
    border:0;
    background:none;
    color:#fff;
    font-size:16px;
}

.ai-body{
    padding:13px;
}

.ai-intro{
    font-size:11px;
    color:#637691;
    margin-bottom:10px;
}

.ai-questions{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-bottom:11px;
}

.ai-question{
    border:1px solid #dbe3ee;
    background:#f7f9fc;
    color:#405572;
    border-radius:7px;
    padding:7px 8px;
    font-size:10px;
    font-weight:700;
    text-align:left;
}

.ai-question:hover{
    border-color:#b9b0ff;
    color:var(--purple);
    background:#f7f5ff;
}

.ai-answer{
    display:none;
    background:#f5f3ff;
    border:1px solid #e1dcff;
    border-radius:9px;
    padding:10px;
    font-size:11px;
    color:#4d5f79;
    line-height:1.5;
    margin-bottom:10px;
}

.ai-answer.show{
